# Copy to .env and edit. docker compose reads it automatically.

# The login on every Spark (see deploy/README.md, step 2).
SPARK_FLEET_SSH_USER=youruser

# Port on this host for the dashboard.
SPARK_FLEET_PORT=8080

# How often every Spark is checked, in minutes.
SPARK_FLEET_INTERVAL_MIN=60

# HTTPS is on by default with a self-signed certificate made on first start.
# To use your own certificate, mount it and point at it:
#SPARK_FLEET_TLS_CERT=/data/tls/cert.pem
#SPARK_FLEET_TLS_KEY=/data/tls/key.pem
# Behind a TLS-terminating reverse proxy ON THE SAME HOST, serve plain HTTP instead.
# If the proxy is on another machine, leave this alone and point the proxy at https://.
#SPARK_FLEET_TLS=off
